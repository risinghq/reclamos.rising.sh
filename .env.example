# Every variable is optional and commented out. An empty value overrides the
# default, except for DATABASE_URL, which is read only when non-empty. The API
# does not load this file. Export the variables.

# Full connection URL. A non-empty value replaces the DB_* variables.
# DATABASE_URL=

# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# PDF_STORE is "local" or "s3".
# PDF_STORE=
# PDF_STORE_PATH=
# PDF_BUCKET=
# S3_ENDPOINT_URL=

# EMBEDDING_MODEL=
# EMBEDDING_CACHE_PATH=
# WORKER_ID=

# Cards, built offline. Without the key of its model's provider, `reclamos cards
# build` or `judge` exits. DAILY_USD_CAP is US dollars per Lima calendar day,
# counted across every process that shares the database (docs/llm.md).
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CARD_MODEL=
# JUDGE_MODEL=
# DAILY_USD_CAP=

# The best similarity below which POST /cases shows no case (docs/cases.md).
# REFUSAL_MIN_SIMILARITY=

# Comma-separated origins whose pages may call the API from a browser. The
# default is the Vite dev server.
# WEB_ORIGINS=

# Searches of /search and /cases one client address may send a minute. 0 turns
# the limit off.
# SEARCHES_PER_MINUTE=30

# Addresses of the proxies whose X-Forwarded-For uvicorn trusts for the client
# address. Read by uvicorn; the default is 127.0.0.1.
# FORWARDED_ALLOW_IPS=

# A PostgreSQL server with pgvector for the integration tests.
# TEST_DATABASE_URL=
